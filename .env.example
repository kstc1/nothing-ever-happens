# Deployment mode (secrets and toggles only — everything else is in config.json)
BOT_MODE=paper
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# Secrets
PRIVATE_KEY=
# Required for signature_type 1, 2, or 3 live (proxy, Gnosis Safe, or deposit wallet address)
FUNDER_ADDRESS=
# connection.signature_type in config.json: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE, 3=POLY_1271 (deposit wallet).
# Type 3: use Polymarket relayer WALLET-CREATE / WALLET for deploy + approvals; fund pUSD on the deposit wallet.
# See https://docs.polymarket.com/trading/deposit-wallet-migration

# Required for BOT_MODE=live
DATABASE_URL=
# Required for proxy-wallet approval bootstrap in live signature_type=2 mode
POLYGON_RPC_URL=

# If Safe getTransactionHash on-chain bootstrap fails (wrong wallet type / manual approvals already done):
# Set to true only after you have manually approved Polymarket CTF exchange operators for your proxy on Polygon.
# PM_NH_SKIP_SAFE_APPROVAL_BOOTSTRAP=false

# Config file path (default: config.json)
# CONFIG_PATH=config.json

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
